# ---- Database (Neon) ----
# Khi tạo Neon qua Vercel (Storage → Neon), Vercel tự thêm 2 biến này.
# Chạy local: copy giá trị từ Vercel/Neon vào đây.
# Pooled connection — dùng khi app chạy
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) — dùng cho `prisma db push` / migrate
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Google OAuth credentials (Google Cloud Console > Credentials > OAuth client ID)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional: set to your deployed URL in production (Vercel usually auto-detects)
# AUTH_URL="https://your-app.vercel.app"
