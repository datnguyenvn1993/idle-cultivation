# ---- Database (Neon / Vercel Postgres / Supabase) ----
# Pooled connection string used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (non-pooled) connection used by `prisma migrate` / `db push`
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- Auth.js (NextAuth v5) ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me"

# Google OAuth credentials (Google Cloud Console > Credentials > OAuth client ID)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional: set to your deployed URL in production (Vercel usually auto-detects)
# AUTH_URL="https://your-app.vercel.app"
